#!/usr/bin/env python3
"""Marca una carpeta como confiable para Claude Code, sin el diálogo de confianza.

Uso: tty7-trust DIR [--config-dir D]
     tty7-trust --remove DIR [--config-dir D]

Escribe projects["<DIR>"].hasTrustDialogAccepted en <config-dir>/.claude.json.
Por defecto <config-dir> es ~/.claude-david (la cuenta de los workers), no $CLAUDE_CONFIG_DIR.
En un git worktree, Claude Code solo mira la raíz del worktree: confía en cada worktree.
"""
import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RETRIES = 5
# Campos por defecto de un proyecto en .claude.json (Claude Code 2.1).
PROJECT_DEFAULTS = {
    "allowedTools": [],
    "mcpContextUris": [],
    "mcpServers": {},
    "enabledMcpjsonServers": [],
    "disabledMcpjsonServers": [],
    "hasClaudeMdExternalIncludesApproved": False,
    "hasClaudeMdExternalIncludesWarningShown": False,
}


class ConfigError(Exception):
    pass


def _stamp(path):
    st = path.stat()
    return (st.st_mtime_ns, st.st_size, st.st_ino)


def _changed(path, before):
    try:
        return _stamp(path) != before
    except OSError:
        return True


def _read(path):
    try:
        before = _stamp(path)
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ConfigError(f"no existe {path}. Abre claude una vez con esa cuenta.")
    except (OSError, ValueError) as e:
        raise ConfigError(f"no pude leer {path}: {e}. No lo cambié.")
    if not isinstance(data, dict):
        raise ConfigError(f"{path} no es un objeto JSON. No lo cambié.")
    return data, before


def update(path, change):
    """Lee path, aplica change(projects) y reemplaza el archivo de forma atómica.

    Claude Code también escribe este archivo. Si el archivo cambia entre la lectura y el
    reemplazo, vuelve a leerlo y aplica el cambio otra vez.
    """
    path = Path(path)
    for _ in range(RETRIES):
        data, before = _read(path)
        projects = data.setdefault("projects", {})
        if not isinstance(projects, dict):
            raise ConfigError(f"'projects' en {path} no es un objeto. No lo cambié.")
        change(projects)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name, suffix=".tmp")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
                f.write("\n")
            os.chmod(tmp, path.stat().st_mode & 0o7777)
            if _changed(path, before):
                os.unlink(tmp)
                continue
            os.replace(tmp, path)
            return
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise
    raise ConfigError(f"{path} cambió {RETRIES} veces durante la escritura. Prueba otra vez.")


def keys(directory):
    """Rutas que Claude Code puede usar como clave: absoluta y real (sin symlinks)."""
    out = [os.path.abspath(directory)]
    real = os.path.realpath(directory)
    if real not in out:
        out.append(real)
    return out


def trust(projects, paths):
    for k in paths:
        entry = projects.get(k)
        if not isinstance(entry, dict):
            entry = projects[k] = {}
        for field, value in PROJECT_DEFAULTS.items():
            entry.setdefault(field, value)
        entry["hasTrustDialogAccepted"] = True


def untrust(projects, paths):
    for k in paths:
        projects.pop(k, None)


def main(argv=None):
    p = argparse.ArgumentParser(prog="tty7-trust",
                                description="Confía en una carpeta para Claude Code.")
    p.add_argument("dir", help="carpeta (la raíz del worktree del worker)")
    p.add_argument("--remove", action="store_true", help="borra la entrada de la carpeta")
    p.add_argument("--config-dir", default=str(Path.home() / ".claude-david"),
                   help="carpeta de configuración (por defecto ~/.claude-david)")
    a = p.parse_args(argv)

    if not a.remove and not os.path.isdir(a.dir):
        print(f"error: la carpeta {a.dir} no existe.", file=sys.stderr)
        return 2
    paths = keys(a.dir)
    cfg = Path(a.config_dir) / ".claude.json"
    try:
        update(cfg, (lambda pr: untrust(pr, paths)) if a.remove else (lambda pr: trust(pr, paths)))
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    print(("Sin confianza: " if a.remove else "Confiable: ") + paths[-1])
    return 0


if __name__ == "__main__":
    sys.exit(main())
